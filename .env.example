# Linux Carrier 1000 - environment (copy to .env)
# Combined start path runs this on :3001 with SMTP on :2526; see
# agent-mail-service/RUN_ON_LINUX.md for the full wired stack.

# Dashboard + API port. Default 3000; use 3001 when the mail API owns :3000.
PORT=3001

# Embedded SIP UDP registrar port (default 5060).
SIP_PORT=5060

# Embedded SMTP inbound listener port (default 2525; use 2526 when the
# agent-mail-service SMTP listener owns :2525 on the same box).
SMTP_INBOUND_PORT=2526

# Carrier identity. The defaults below are the DEMO profile only
# (TEST-NET-2 IP, not a real public host): set your own domain + public IP
# before expecting internet mail or calls.
CARRIER_DOMAIN=sms.customlinux.org
CARRIER_PUBLIC_IP=198.51.100.45

# Coturn TURN relay for cross-network WebRTC. Shared secret with
# agent-mail-service: TURN_SECRET here is the same secret as
# PHONE_TURN_SECRET there (one Coturn instance serves both).
TURN_URL=
TURN_SECRET=
# TURN_PASSWORD is accepted as an alias for TURN_SECRET.

# Agent mail API that the Agent Mail tab proxies for live inbox counts.
# Default http://127.0.0.1:3000 (agent-mail-service, see RUN_ON_LINUX.md).
AGENT_MAIL_URL=http://127.0.0.1:3000

# Unauthenticated SIP REGISTER gate. Default 0 (refused with 403; OPTIONS
# still answers). Set to 1 only on localhost, only when you mean it.
SIP_ALLOW_UNAUTH_REGISTER=0

# Optional Asterisk AMI for PBX originate (leave unset without Asterisk).
AMI_HOST=
AMI_PORT=5038
AMI_USER=
AMI_SECRET=

# AI Studio key (only used by the AI Studio hosted preview, not by the
# self-hosted Linux run).
GEMINI_API_KEY=
